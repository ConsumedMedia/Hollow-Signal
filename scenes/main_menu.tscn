[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_nav"]
[ext_resource type="Theme" path="res://ui/prototype_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/placeholder_stage.gd" id="3_stage"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_nav")
initial_focus = NodePath("Margin/Layout/Body/Actions/NewGame")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.035, 0.051, 0.075, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 96
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 96
theme_override_constants/margin_bottom = 32

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.47, 0.84, 0.85, 1)
theme_override_font_sizes/font_size = 24
text = "HOLLOW SIGNAL   /   PROTOTYPE 03"

[node name="Rule" type="HSeparator" parent="Margin/Layout"]
layout_mode = 2

[node name="Body" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 60

[node name="Actions" type="VBoxContainer" parent="Margin/Layout/Body"]
custom_minimum_size = Vector2(720, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12
alignment = 1

[node name="Eyebrow" type="Label" parent="Margin/Layout/Body/Actions"]
layout_mode = 2
theme_override_colors/font_color = Color(0.86, 0.56, 0.41, 1)
theme_override_font_sizes/font_size = 24
text = "A TRANSMISSION IN THE DARK"

[node name="Title" type="Label" parent="Margin/Layout/Body/Actions"]
layout_mode = 2
theme_override_font_sizes/font_size = 68
text = "HOLLOW\nSIGNAL"

[node name="Description" type="Label" parent="Margin/Layout/Body/Actions"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.73, 0.77, 1)
text = "A salvage crew. A silent vessel.\nSomething is still transmitting."

[node name="Spacer" type="Control" parent="Margin/Layout/Body/Actions"]
custom_minimum_size = Vector2(0, 0)
layout_mode = 2
mouse_filter = 2

[node name="NewGame" type="Button" parent="Margin/Layout/Body/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "New Game"

[node name="LoadGame" type="Button" parent="Margin/Layout/Body/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Load Campaign"

[node name="RecoverBackup" type="Button" parent="Margin/Layout/Body/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Recover Known-Good Backup"

[node name="BattleTest" type="Button" parent="Margin/Layout/Body/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Battle Test"

[node name="Help" type="Button" parent="Margin/Layout/Body/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "How to Play"

[node name="Quit" type="Button" parent="Margin/Layout/Body/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Quit"

[node name="Preview" type="VBoxContainer" parent="Margin/Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16
alignment = 1

[node name="SchematicLabel" type="Label" parent="Margin/Layout/Body/Preview"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "DERELICT RESEARCH VESSEL"

[node name="Schematic" type="Control" parent="Margin/Layout/Body/Preview"]
custom_minimum_size = Vector2(640, 360)
layout_mode = 2
mouse_filter = 2
script = ExtResource("3_stage")

[node name="PreviewNote" type="Label" parent="Margin/Layout/Body/Preview"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.73, 0.77, 1)
theme_override_font_sizes/font_size = 24
text = "Eight-room exploration and crew combat.\nManage eight crew, equipment and recovery.\nVersioned campaign checkpoints with recovery."

[node name="SaveStatus" type="Label" parent="Margin/Layout/Body/Preview"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
text = "AUTOSAVE / checking..."

[node name="NewGameConfirmation" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Replace campaign?"
dialog_text = "New Game replaces the current autosave after you confirm. A damaged or incompatible save is never replaced merely by loading the menu. Continue?"
ok_button_text = "Replace and start"

[node name="FooterRule" type="HSeparator" parent="Margin/Layout"]
layout_mode = 2

[node name="Footer" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.73, 0.77, 1)
theme_override_font_sizes/font_size = 24
text = "CLICK to select   /   TAB or ARROWS to focus   /   ENTER to confirm   /   F11 fullscreen"

[connection signal="pressed" from="Margin/Layout/Body/Actions/BattleTest" to="." method="open_screen" binds= ["res://scenes/battle_test.tscn"]]
[connection signal="pressed" from="Margin/Layout/Body/Actions/Help" to="." method="open_screen" binds= ["res://scenes/help.tscn"]]
[connection signal="pressed" from="Margin/Layout/Body/Actions/Quit" to="." method="quit_game"]
