[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/screen_navigation.gd" id="1_nav"]
[ext_resource type="Theme" path="res://ui/prototype_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/placeholder_stage.gd" id="3_stage"]

[node name="Hub" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_nav")
initial_focus = NodePath("Margin/Layout/Navigation/OpenBattleTest")
back_scene = "res://scenes/main_menu.tscn"

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.035, 0.051, 0.075, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 96
theme_override_constants/margin_top = 64
theme_override_constants/margin_right = 96
theme_override_constants/margin_bottom = 56

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Header" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.47, 0.84, 0.85, 1)
theme_override_font_sizes/font_size = 24
text = "HOLLOW SIGNAL   /   HUB"

[node name="Title" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 64
text = "Salvage operations"

[node name="Subtitle" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.73, 0.77, 1)
text = "Hub placeholder — your future staging area before entering the derelict."

[node name="Body" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 32

[node name="VesselPanel" type="PanelContainer" parent="Margin/Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Vessel" type="VBoxContainer" parent="Margin/Layout/Body/VesselPanel"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Label" type="Label" parent="Margin/Layout/Body/VesselPanel/Vessel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.47, 0.84, 0.85, 1)
text = "RESEARCH VESSEL / SIGNAL DETECTED"

[node name="Schematic" type="Control" parent="Margin/Layout/Body/VesselPanel/Vessel"]
custom_minimum_size = Vector2(640, 300)
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
script = ExtResource("3_stage")

[node name="Note" type="Label" parent="Margin/Layout/Body/VesselPanel/Vessel"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Explore eight authored rooms. Optional salvage and hazard branch; a route to the boss placeholder."
autowrap_mode = 2

[node name="SetupPanel" type="PanelContainer" parent="Margin/Layout/Body"]
custom_minimum_size = Vector2(650, 0)
layout_mode = 2
size_flags_horizontal = 3

[node name="Info" type="VBoxContainer" parent="Margin/Layout/Body/SetupPanel"]
layout_mode = 2
theme_override_constants/separation = 28
alignment = 1

[node name="Title" type="Label" parent="Margin/Layout/Body/SetupPanel/Info"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "First contact is ready"

[node name="Description" type="Label" parent="Margin/Layout/Body/SetupPanel/Info"]
layout_mode = 2
text = "The hub is still a placeholder.\n\nExplore the ship with four crew, shared power and a twelve-slot hold, or open the isolated battle test."
autowrap_mode = 2

[node name="Rule" type="HSeparator" parent="Margin/Layout/Body/SetupPanel/Info"]
layout_mode = 2

[node name="Scope" type="Label" parent="Margin/Layout/Body/SetupPanel/Info"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.73, 0.77, 1)
theme_override_font_sizes/font_size = 24
text = "Crew selection, recruitment, supplies, recovery and upgrades are not implemented yet. No campaign data is created."
autowrap_mode = 2

[node name="Navigation" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="OpenBattleTest" type="Button" parent="Margin/Layout/Navigation"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Open Battle Test"

[node name="MainMenu" type="Button" parent="Margin/Layout/Navigation"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Main Menu"

[node name="ExploreShip" type="Button" parent="Margin/Layout/Navigation"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Explore Ship"

[node name="Footer" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.73, 0.77, 1)
theme_override_font_sizes/font_size = 24
text = "ESC main menu   /   TAB or ARROWS to focus   /   ENTER to confirm   /   F11 fullscreen"

[connection signal="pressed" from="Margin/Layout/Navigation/OpenBattleTest" to="." method="open_screen" binds= ["res://scenes/battle_test.tscn"]]
[connection signal="pressed" from="Margin/Layout/Navigation/MainMenu" to="." method="open_screen" binds= ["res://scenes/main_menu.tscn"]]
[connection signal="pressed" from="Margin/Layout/Navigation/ExploreShip" to="." method="open_screen" binds= ["res://scenes/expedition.tscn"]]
