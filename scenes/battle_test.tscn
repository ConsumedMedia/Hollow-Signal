[node name="Actions" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Strike" type="Button" parent="Margin/Layout/Actions"]
theme_override_colors/font_disabled_color = Color(0.72, 0.76, 0.78, 1)
theme_override_styles/disabled = SubResource("DisabledButton")
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Close strike"

[node name="Shot" type="Button" parent="Margin/Layout/Actions"]
theme_override_colors/font_disabled_color = Color(0.72, 0.76, 0.78, 1)
theme_override_styles/disabled = SubResource("DisabledButton")
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Covering shot"

[node name="Skill3" type="Button" parent="Margin/Layout/Actions"]
theme_override_colors/font_disabled_color = Color(0.72, 0.76, 0.78, 1)
theme_override_styles/disabled = SubResource("DisabledButton")
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Third ability"

[node name="Move" type="Button" parent="Margin/Layout/Actions"]
theme_override_colors/font_disabled_color = Color(0.72, 0.76, 0.78, 1)
theme_override_styles/disabled = SubResource("DisabledButton")
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Move / swap"

[node name="Wait" type="Button" parent="Margin/Layout/Actions"]
theme_override_colors/font_disabled_color = Color(0.72, 0.76, 0.78, 1)
theme_override_styles/disabled = SubResource("DisabledButton")
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Wait / skip"

[node name="ActionHelp" type="Label" parent="Margin/Layout"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 84)
theme_override_font_sizes/font_size = 22
text = "Attack requirements and selection appear here."
autowrap_mode = 2

[node name="SelectedDetail" type="Label" parent="Margin/Layout"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 52)
theme_override_font_sizes/font_size = 22
autowrap_mode = 2
text = "Selected ability details and target damage."

[node name="StatusPanel" type="PanelContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_styles/panel = SubResource("CompactPanel")


[node name="Status" type="Label" parent="Margin/Layout/StatusPanel"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 84)
theme_override_font_sizes/font_size = 22
text = "Battle events appear here."
autowrap_mode = 2

[node name="Navigation" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Encounter" type="Button" parent="Margin/Layout/Navigation"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Boarding patrol / switch"
tooltip_text = "Switch test encounters and restart. Signal patrol replaces the Tow Drone with a strain attacker."

[node name="Restart" type="Button" parent="Margin/Layout/Navigation"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Fresh expedition"
tooltip_text = "TEST RESET: creates new crew and 100 power with the same seed. Does not revive the old expedition's dead."

[node name="NextBattle" type="Button" parent="Margin/Layout/Navigation"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Next battle / −5 power"
tooltip_text = "Victory only. Test corridor: spend 5 power, apply room-entry strain, keep survivors and start the patrol again. No exploration map yet."

[node name="BackToHub" type="Button" parent="Margin/Layout/Navigation"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Back to Hub"

[node name="ReturnToRoom" type="Button" parent="Margin/Layout/Navigation"]
layout_mode = 2
unique_name_in_owner = true
visible = false
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Return to room"

[node name="MainMenu" type="Button" parent="Margin/Layout/Navigation"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Main Menu"

[node name="RulesLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.73, 0.77, 1)
theme_override_font_sizes/font_size = 22
text = "Downed, death and Shaken rules"

[node name="Footer" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Test session only: leaving/resetting creates fresh crew. No disk save yet. ESC hub / TAB focus / ENTER confirm / F11 fullscreen"

[connection signal="timeout" from="BattleController/EnemyDelay" to="BattleController" method="_on_enemy_delay_timeout"]
[connection signal="pressed" from="Margin/Layout/Navigation/Restart" to="." method="restart_battle"]
[connection signal="pressed" from="Margin/Layout/Navigation/BackToHub" to="." method="open_screen" binds= ["res://scenes/hub.tscn"]]
[connection signal="pressed" from="Margin/Layout/Navigation/MainMenu" to="." method="open_screen" binds= ["res://scenes/main_menu.tscn"]]
