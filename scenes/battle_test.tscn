[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/battle_screen.gd" id="1_nav"]
[ext_resource type="Theme" path="res://ui/prototype_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/placeholder_stage.gd" id="3_stage"]
[ext_resource type="Script" path="res://scripts/battle_controller.gd" id="4_controller"]

[sub_resource type="StyleBoxFlat" id="DisabledButton"]
content_margin_left = 12.0
content_margin_top = 18.0
content_margin_right = 12.0
content_margin_bottom = 18.0
bg_color = Color(0.055, 0.075, 0.095, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.16, 0.23, 0.28, 1)

[sub_resource type="StyleBoxFlat" id="CardNormal"]
content_margin_left = 12.0
content_margin_right = 12.0
content_margin_top = 18.0
content_margin_bottom = 18.0
bg_color = Color(0.105, 0.17, 0.215, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.29, 0.41, 0.46, 1)

[sub_resource type="StyleBoxFlat" id="CardHover"]
content_margin_left = 12.0
content_margin_right = 12.0
content_margin_top = 18.0
content_margin_bottom = 18.0
bg_color = Color(0.16, 0.27, 0.31, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.47, 0.84, 0.85, 1)

[sub_resource type="StyleBoxFlat" id="CompactPanel"]
content_margin_left = 16.0
content_margin_right = 16.0
content_margin_top = 12.0
content_margin_bottom = 12.0
bg_color = Color(0.058, 0.096, 0.132, 1)

[node name="BattleTest" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_nav")
initial_focus = NodePath("Margin/Layout/Navigation/Restart")
back_scene = "res://scenes/hub.tscn"

[node name="BattleController" type="Node" parent="."]
script = ExtResource("4_controller")

[node name="EnemyDelay" type="Timer" parent="BattleController"]
wait_time = 0.4
one_shot = true

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.035, 0.051, 0.075, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 16

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.47, 0.84, 0.85, 1)
theme_override_font_sizes/font_size = 22
text = "HOLLOW SIGNAL   /   CREW VULNERABILITY & POWER TEST"

[node name="TurnLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
unique_name_in_owner = true
theme_override_font_sizes/font_size = 28
text = "Round 1 / Initiative"

[node name="OrderLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
unique_name_in_owner = true
theme_override_font_sizes/font_size = 22
text = "Remaining order (Speed + d6)"

[node name="Sides" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="PowerBar" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="PowerLabel" type="Label" parent="Margin/Layout/PowerBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "POWER 100/100"

[node name="Overcharge" type="CheckButton" parent="Margin/Layout/PowerBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Overcharge / 10 power / +50% damage"

[node name="Drill" type="Button" parent="Margin/Layout/PowerBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Vulnerability drill"
tooltip_text = "Starts a NEW test fixture: Medic first, C1 downed, C3 Shaken, 10 power. Not a normal expedition."


[node name="CrewLabel" type="Label" parent="Margin/Layout/Sides"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.47, 0.84, 0.85, 1)
theme_override_font_sizes/font_size = 22
text = "CREW   /   rear  4  3  2  1  front >"
horizontal_alignment = 1

[node name="EnemyLabel" type="Label" parent="Margin/Layout/Sides"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.86, 0.56, 0.41, 1)
theme_override_font_sizes/font_size = 22
text = "< front  1  2  3  4  rear   /   ENEMY"
horizontal_alignment = 1

[node name="Stage" type="Control" parent="Margin/Layout"]
layout_mode = 2
custom_minimum_size = Vector2(0, 65)
size_flags_vertical = 3
mouse_filter = 2
script = ExtResource("3_stage")
display = 1

[node name="Formation" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="CrewSlots" type="HBoxContainer" parent="Margin/Layout/Formation"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="CrewRank4" type="Button" parent="Margin/Layout/Formation/CrewSlots"]
theme_override_colors/font_disabled_color = Color(0.72, 0.76, 0.78, 1)
theme_override_styles/disabled = SubResource("DisabledButton")
theme_override_styles/normal = SubResource("CardNormal")
theme_override_styles/hover = SubResource("CardHover")
theme_override_styles/pressed = SubResource("CardHover")
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "Rank 4\nHP —\nStanding"

