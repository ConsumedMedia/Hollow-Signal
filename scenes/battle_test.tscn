mouse_filter = 2

[node name="EnemySlots" type="HBoxContainer" parent="Margin/Layout/Formation"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="EnemyRank1" type="Button" parent="Margin/Layout/Formation/EnemySlots"]
