[gd_resource type="Resource" script_class="RoomDefinition" load_steps=8 format=3]

[ext_resource type="Script" path="res://content/room_definition.gd" id="script"]
[ext_resource type="Script" path="res://content/actor_definition.gd" id="actor_script"]
[ext_resource type="Resource" path="res://content/actors/mauler.tres" id="mauler"]
[ext_resource type="Resource" path="res://content/actors/chorister.tres" id="chorister"]
[ext_resource type="Script" path="res://content/item_drop.gd" id="drop_script"]
[ext_resource type="Resource" path="res://content/items/scrap.tres" id="scrap"]

[sub_resource type="Resource" id="drop_scrap"]
script = ExtResource("drop_script")
item = ExtResource("scrap")
quantity = 3

[resource]
script = ExtResource("script")
id = &"receiving"
display_name = "Receiving"
description = "A cargo sentinel and a broken relay guard the receiving deck. Clear the patrol before proceeding."
kind = 1
links = Array[StringName]([&"airlock", &"junction"])
map_column = 1
map_row = 0
enemies = Array[ExtResource("actor_script")]([ExtResource("mauler"), ExtResource("chorister")])
loot = Array[ExtResource("drop_script")]([SubResource("drop_scrap")])
strain_cost = 0
recovery_health = 0
recovery_strain = 0
