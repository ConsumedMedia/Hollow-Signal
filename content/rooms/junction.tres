[gd_resource type="Resource" script_class="RoomDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://content/room_definition.gd" id="script"]
[ext_resource type="Script" path="res://content/actor_definition.gd" id="actor_script"]
[ext_resource type="Resource" path="res://content/actors/mauler.tres" id="mauler"]
[ext_resource type="Resource" path="res://content/actors/bulwark.tres" id="bulwark"]
[ext_resource type="Resource" path="res://content/actors/needle.tres" id="needle"]
[ext_resource type="Script" path="res://content/item_drop.gd" id="drop_script"]
[ext_resource type="Resource" path="res://content/items/wafer.tres" id="wafer"]

[sub_resource type="Resource" id="drop_wafer"]
script = ExtResource("drop_script")
item = ExtResource("wafer")
quantity = 2

[resource]
script = ExtResource("script")
id = &"junction"
display_name = "Junction"
description = "A fortified patrol blocks the central junction. The safe room leads toward the signal. The salvage bay and pressure breach form an optional branch."
kind = 1
links = Array[StringName]([&"receiving", &"safe_room", &"salvage"])
map_column = 2
map_row = 0
enemies = Array[ExtResource("actor_script")]([ExtResource("mauler"), ExtResource("bulwark"), ExtResource("needle")])
loot = Array[ExtResource("drop_script")]([SubResource("drop_wafer")])
strain_cost = 0
recovery_health = 0
recovery_strain = 0
