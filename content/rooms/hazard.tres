[gd_resource type="Resource" script_class="RoomDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://content/room_definition.gd" id="script"]
[ext_resource type="Script" path="res://content/item_drop.gd" id="drop_script"]
[ext_resource type="Resource" path="res://content/items/wafer.tres" id="wafer"]
[ext_resource type="Resource" path="res://content/items/power_cell.tres" id="power_cell"]

[sub_resource type="Resource" id="drop_wafer"]
script = ExtResource("drop_script")
item = ExtResource("wafer")
quantity = 4

[sub_resource type="Resource" id="drop_power_cell"]
script = ExtResource("drop_script")
item = ExtResource("power_cell")
quantity = 1

[resource]
script = ExtResource("script")
id = &"hazard"
display_name = "Pressure breach"
description = "Loose lockers hang over a ruptured pressure pipe. Searching adds 12 strain to every surviving crew member; sealing the bulkhead gives no loot."
kind = 3
links = Array[StringName]([&"salvage"])
map_column = 3
map_row = 1
loot = Array[ExtResource("drop_script")]([SubResource("drop_wafer"), SubResource("drop_power_cell")])
strain_cost = 12
recovery_health = 0
recovery_strain = 0
